// jak-web: see src/worker.js and README.md. Nothing here is secret; the allowed emails live only
// in the Cloudflare Access policy (CLAUDE.MD decision 10).
{
  "$schema": "https://unpkg.com/wrangler@4.151.3/config-schema.json",
  "name": "jak-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // gk_web.{html,js,wasm,data} copied by build_site.sh (runtime + shaders, no game data)
  "assets": {
    "directory": "../../build-wasm/host-site",
    "binding": "ASSETS",
    // serve gk_web.html as is (no /gk_web.html -> /gk_web redirect)
    "html_handling": "none",
    // the Worker checks Access and adds COOP/COEP on every request, static files included
    "run_worker_first": true
  },
  "r2_buckets": [
    // game files, read-only (upload_data.sh)
    { "binding": "DATA", "bucket_name": "jak-data" },
    // each user's saves and settings, under <email>/ (decision 11)
    { "binding": "SAVES", "bucket_name": "jak-saves" }
  ],
  // The workers.dev address, on since Access protects the Worker (all traffic). Previews stay off.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // the Access team, and the AUD tag of the Access application protecting this Worker.
    // Empty = every request is refused.
    "ACCESS_TEAM_DOMAIN": "holy-river-1117.cloudflareaccess.com",
    "ACCESS_AUD": "13b36507a435c59306a6cbd87a5e58cb2b88c7456fa353a9db2dc56070edc18f"
  }
}
