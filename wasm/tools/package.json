{
  "name": "jak-wasm-tools",
  "private": true,
  "type": "module",
  "description": "Dev tooling for the OpenGOAL WebAssembly/WebGL2 port. Not shipped.",
  "scripts": {
    "shaders": "node gles-shaders.mjs --src ../../game/graphics/opengl_renderer/shaders --out ../../build-wasm/shaders_es",
    "shader-smoke": "node webgl-shader-smoke.mjs --dir ../../build-wasm/shaders_es",
    "test": "node selftest.mjs"
  },
  "devDependencies": {
    "glslang-validator-prebuilt-predownloaded": "0.0.2",
    "pixelmatch": "7.1.0",
    "playwright": "1.56.0",
    "pngjs": "7.0.0"
  }
}
