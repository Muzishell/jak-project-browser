;; 128-bit integer ops, printed as two 64-bit halves (high, low)

(defmacro make128 (hi lo)
  `(let ((r (the uint128 0)))
     (.pcpyld r (the uint128 ,hi) (the uint128 ,lo))
     r))

(defmacro show128 (fmt q)
  `(let ((buf (new 'stack-no-clear 'array 'uint64 2)))
     (set! (-> (the (pointer uint128) buf)) ,q)
     (_format #t ,fmt (-> buf 1) (-> buf 0))))

(let ((a (make128 #x0f0e0d0c0b0a0908 #x0706050403020100))
      (b (make128 #x1f1e1d1c1b1a1918 #x1716151413121110))
      (c (make128 #x7fff00ff8000017f #x80017ffe00810002))
      (r (the uint128 0)))
  (.pextlb r a b) (show128 "pextlb ~X ~X~%" r)
  (.pextlh r a b) (show128 "pextlh ~X ~X~%" r)
  (.pextlw r a b) (show128 "pextlw ~X ~X~%" r)
  (.pextub r a b) (show128 "pextub ~X ~X~%" r)
  (.pextuh r a b) (show128 "pextuh ~X ~X~%" r)
  (.pextuw r a b) (show128 "pextuw ~X ~X~%" r)
  (.pcpyld r a b) (show128 "pcpyld ~X ~X~%" r)
  (.pcpyud r a b) (show128 "pcpyud ~X ~X~%" r)
  (.pceqb r a a) (show128 "pceqb ~X ~X~%" r)
  (.pceqh r a c) (show128 "pceqh ~X ~X~%" r)
  (.pceqw r b b) (show128 "pceqw ~X ~X~%" r)
  (.pcgtb r c a) (show128 "pcgtb ~X ~X~%" r)
  (.pcgth r c a) (show128 "pcgth ~X ~X~%" r)
  (.pcgtw r a c) (show128 "pcgtw ~X ~X~%" r)
  (.psubw r a b) (show128 "psubw ~X ~X~%" r)
  (.por r a c) (show128 "por ~X ~X~%" r)
  (.pxor r a c) (show128 "pxor ~X ~X~%" r)
  (.pand r a c) (show128 "pand ~X ~X~%" r)
  (.pnor r a c) (show128 "pnor ~X ~X~%" r)
  (.paddb r a c) (show128 "paddb ~X ~X~%" r)
  (.ppach r a c) (show128 "ppach ~X ~X~%" r)
  (.ppacb r a c) (show128 "ppacb ~X ~X~%" r)
  0
  )
