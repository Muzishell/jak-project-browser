;; vector float ops on values built from bit patterns, printed as hex lanes (w z y x)

(defmacro make128 (hi lo)
  `(let ((r (the uint128 0)))
     (.pcpyld r (the uint128 ,hi) (the uint128 ,lo))
     r))

(defmacro showvf (fmt vf)
  `(let ((buf (new 'stack-no-clear 'array 'uint32 4)))
     (.svf buf ,vf)
     (_format #t ,fmt (-> buf 3) (-> buf 2) (-> buf 1) (-> buf 0))))

(rlet ((v1 :class vf)
       (v2 :class vf)
       (v3 :class vf)
       (acc :class vf))
  ;; v1 = (1.0 -2.5 3.0 0.5), v2 = (4.0 2.0 -1.0 0.5) as (x y z w)
  (let ((a (make128 #x3f00000040400000 #xc02000003f800000))
        (b (make128 #x3f000000bf800000 #x4000000040800000)))
    (.mov v1 a)
    (.mov v2 b))
  (.add.vf v3 v1 v2) (showvf "add ~X ~X ~X ~X~%" v3)
  (.sub.vf v3 v1 v2) (showvf "sub ~X ~X ~X ~X~%" v3)
  (.mul.vf v3 v1 v2) (showvf "mul ~X ~X ~X ~X~%" v3)
  (.div.vf v3 v1 v2 :fsf #b10 :ftf #b01) (showvf "div ~X ~X ~X ~X~%" v3)
  (.max.vf v3 v1 v2) (showvf "max ~X ~X ~X ~X~%" v3)
  (.min.vf v3 v1 v2) (showvf "min ~X ~X ~X ~X~%" v3)
  (.xor.vf v3 v1 v2) (showvf "xor ~X ~X ~X ~X~%" v3)
  (.abs.vf v3 v1) (showvf "abs ~X ~X ~X ~X~%" v3)
  (.add.x.vf v3 v1 v2) (showvf "add.x ~X ~X ~X ~X~%" v3)
  (.mul.w.vf v3 v1 v2) (showvf "mul.w ~X ~X ~X ~X~%" v3)
  (.add.vf v3 v1 v2 :mask #b0101) (showvf "add.mask ~X ~X ~X ~X~%" v3)
  (.blend.vf v3 v1 v2 :mask #b1010) (showvf "blend ~X ~X ~X ~X~%" v3)
  (.sqrt.vf v3 v2 :ftf #b00) (showvf "sqrt ~X ~X ~X ~X~%" v3)
  (.ftoi.vf v3 v1) (showvf "ftoi ~X ~X ~X ~X~%" v3)
  (.itof.vf v3 v3) (showvf "itof ~X ~X ~X ~X~%" v3)
  (.outer.product.vf v3 v1 v2) (showvf "outer ~X ~X ~X ~X~%" v3)
  (.mul.vf acc v1 v2)
  (.add.mul.vf v3 v1 v2 acc) (showvf "add.mul ~X ~X ~X ~X~%" v3)
  (.pw.sll v3 v2 4) (showvf "pw.sll ~X ~X ~X ~X~%" v3)
  (.pw.srl v3 v1 3) (showvf "pw.srl ~X ~X ~X ~X~%" v3)
  (.pw.sra v3 v1 3) (showvf "pw.sra ~X ~X ~X ~X~%" v3)
  (.pw.sll v3 v2 40) (showvf "pw.sll.big ~X ~X ~X ~X~%" v3)
  0
  )
